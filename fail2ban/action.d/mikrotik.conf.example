[Definition]

# Fail2ban action for MikroTik RouterOS.
# Install mikrotik-fail2ban.sh somewhere root can execute, for example:
#   /usr/local/sbin/mikrotik-fail2ban.sh
#
# The helper uses SSH key authentication. Configure ROUTER_HOST,
# ROUTER_USER, ROUTER_PORT and optionally SSH_IDENTITY in the wrapper,
# a systemd environment file, or another local mechanism appropriate
# for your installation.

actionstart =
actionstop =
actioncheck =

# Add the banned IP to a dedicated RouterOS address-list.
# RouterOS removes it automatically after the timeout expires.
actionban = /usr/local/sbin/mikrotik-fail2ban.sh "/ip firewall address-list add list=threat address=<ip> timeout=1d"

# No explicit unban is needed when RouterOS timeout is used.
actionunban =
